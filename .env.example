# Copy this file to `.env.local` for local development, or add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Set at least one of them so the contact form can deliver messages.

# Preferred: a form endpoint that accepts JSON POST requests,
# e.g. a free Formspree form: https://formspree.io/f/your-form-id
VITE_FORM_ENDPOINT=

# Fallback: the form opens the visitor's email app addressed to this email.
VITE_CONTACT_EMAIL=
